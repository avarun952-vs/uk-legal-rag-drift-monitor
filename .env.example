LLM_PROVIDER=extractive

# OpenAI-compatible settings
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Ollama settings
OLLAMA_MODEL=llama3.1
OLLAMA_BASE_URL=http://localhost:11434

# Retrieval settings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
TOP_K=4
CHUNK_SIZE=700
CHUNK_OVERLAP=120

# Confidence gate: below this top-1 similarity, no LLM answer is generated
MIN_CONFIDENCE=0.35

# Drift monitoring: queries needed before retrieval drift is reported
MIN_DRIFT_WINDOW=20

# Paths
SOURCE_DIR=data/source_documents
VECTOR_DIR=data/vector_store
REFERENCE_QUERIES=data/reference_queries.txt
